# Cabeceras para Netlify (y compatibles con Cloudflare Pages).
#
# Los archivos de /assets/ llevan un hash en el nombre: su contenido nunca
# cambia, asi que se pueden cachear para siempre. El resto conserva el mismo
# nombre entre publicaciones, y si el navegador los guardara, cambiar la foto
# y volver a publicar no se notaria.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/avatar.jpg
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=0, must-revalidate
